# Copy this file to server/.env for a manual local or production setup.
# Never commit real tokens or API keys.

# Required in production. Generate a long random value.
DAILY_SUMMARY_TOKEN=replace-with-a-long-random-token

# Bind the API locally when Caddy or another reverse proxy is in front.
DAILY_SUMMARY_BIND=127.0.0.1:8080
DAILY_SUMMARY_ALLOWED_ORIGINS=http://127.0.0.1:8080

# Keep disabled for manual production setups. The npm run server:dev script
# overrides this with 1 while binding only to the local machine.
DAILY_SUMMARY_ALLOW_NO_TOKEN=0

# Optional AI support. Leave the key empty to disable AI features.
# The Settings -> AI page can override these values at runtime; values saved there
# are persisted in the SQLite database and take precedence over this file.
DAILY_SUMMARY_AI_API_KEY=
DAILY_SUMMARY_AI_BASE_URL=https://api.openai.com/v1
DAILY_SUMMARY_AI_MODEL=gpt-4o-mini
DAILY_SUMMARY_AI_TEMPERATURE=0.2
DAILY_SUMMARY_AI_MAX_TOKENS=0
DAILY_SUMMARY_AI_TIMEOUT_SECS=45
DAILY_SUMMARY_AI_RETRIES=2
DAILY_SUMMARY_AI_MIN_INTERVAL_MS=1200
