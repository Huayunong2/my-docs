{
  "name": "daily-summary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "npx tsc -b && vite build",
    "check:bundle": "npm run check:ui && npm run build -- --manifest && node scripts/check-frontend-budget.mjs",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "preview": "vite preview",
    "server:dev": "cd server && DAILY_SUMMARY_ALLOW_NO_TOKEN=1 DAILY_SUMMARY_LOCAL_AI_ACCESS=1 DAILY_SUMMARY_LOCAL_AI_TOKEN=daily-summary-local-ai-test-token DAILY_SUMMARY_BIND=127.0.0.1:8080 cargo run",
    "server:build": "cd server && cargo build --release",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
